#!/bin/sh
# pre-push：推送前跑冒烟与争议登记核对。纯本地、不调模型。
#
# - smoke_test_chains.py   判据链路断言（含各靶场踩坑形态的回归锁）
# - export_disputes.py --check   争议登记的证据能否逐字对上源码
#
# 靶场未克隆导致证据核对过不了时，可 git push --no-verify 临时豁免，
# 但必须知道自己在豁免什么。

set -e
cd "$(git rev-parse --show-toplevel)"

PY=""
for c in "C:/Users/ee54/.workbuddy/binaries/python/envs/default/Scripts/python.exe" python python3; do
  if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done
if [ -z "$PY" ]; then
  echo "✘ pre-push: 找不到 python，跳过检查（请安装或用 --no-verify）" >&2
  exit 1
fi

echo "pre-push: 冒烟测试 ..."
"$PY" benchmarks/smoke_test_chains.py > /dev/null
echo "pre-push: 冒烟通过 ✔"

echo "pre-push: 争议登记核对 ..."
"$PY" benchmarks/export_disputes.py --check

# 第 5 靶场基线：只在仓库已克隆时跑。它锁的是"切片穿透 + authz 真值 +
# sqli 方向护栏"，不调模型、秒级完成；基线漂移说明切片器动了却没同步。
if [ -d reference_repos/newbee-mall-master ]; then
  echo "pre-push: newbee-mall 基线 ..."
  "$PY" benchmarks/benchmark_newbeemall.py --strict > /dev/null
  echo "pre-push: newbee-mall 基线通过 ✔"
fi

# 第 6 靶场：同一套业务的前后端分离 API 版。主体在**签名**上
# （`@TokenToMallUser MallUser user`），方法体里没有任何 session 取值，
# 是唯一能验证"主体识别不靠方法体"的样本。
if [ -d reference_repos/newbee-mall-api-master ]; then
  echo "pre-push: newbee-mall-api 基线 ..."
  "$PY" benchmarks/benchmark_newbeemallapi.py --strict > /dev/null
  echo "pre-push: newbee-mall-api 基线通过 ✔"
fi

# 第 7 靶场（Python）：vulpy bad/good 成对真值。锁住"蓝图路由 +
# 跨文件 Hop + 参数化 vs 拼接"整条 Python 链路；判据漂移立刻红。
if [ -d reference_repos/vulpy-master ]; then
  echo "pre-push: vulpy 基线 ..."
  "$PY" benchmarks/benchmark_vulpy.py --strict > /dev/null
  echo "pre-push: vulpy 基线通过 ✔"
fi

# 第 8 靶场（Solidity）：smartbugs-curated 官方行号真值。锁住"老语法
# 重入 CEI + modifier 实现体核验 + 错名构造函数"整条 Solidity 链路。
# --offline 是硬要求：模型层（Module 17）默认会跑 197 条退回样本，
# 门禁里发网络请求既慢又不可复现，且模型非确定性不能当门禁。
if [ -d reference_repos/smartbugs-curated-main ]; then
  echo "pre-push: smartbugs 基线 ..."
  "$PY" benchmarks/benchmark_smartbugs.py --strict --offline > /dev/null
  echo "pre-push: smartbugs 基线通过 ✔"
fi

# 第 9 靶场（Solidity 0.8.x）：DeFiVulnLabs 成对真值（漏洞合约 + 修复合约
# 里同名函数各一份）。这是唯一能验证"判据看机制不看名字"的样本 ——
# smartbugs 的同文件未标注函数只能靠人工判断真值口径，这里真值是成对的。
# 同时它把 access_control 的漏洞分母从 18 补到 22，越过了记忆条 3 的 20 条线。
if [ -d reference_repos/DeFiVulnLabs-main ]; then
  echo "pre-push: DeFiVulnLabs 基线 ..."
  "$PY" benchmarks/benchmark_defivulnlabs.py --strict --offline > /dev/null
  echo "pre-push: DeFiVulnLabs 基线通过 ✔"
fi

# 第 10 靶场（Solidity）：not-so-smart-contracts（Trail of Bits 官方漏洞集）。
# 补 access_control 分母裕度（smartbugs 18 + DeFiVulnLabs 2 + nssc 4+）。
# 真值只收 README 指名条目；honeypots 是陷阱口径不收。离线门禁 --offline。
if [ -d reference_repos/not-so-smart-contracts-master ]; then
  echo "pre-push: not-so-smart-contracts 基线 ..."
  "$PY" benchmarks/benchmark_nssc.py --strict --offline > /dev/null
  echo "pre-push: not-so-smart-contracts 基线通过 ✔"
fi

# 第 11 靶场（Module 22/23）：RuoYi 企业级多模块——跨 Maven 子模块穿透 +
# @RequiresPermissions 注解语义 + ${params.dataScope} 切面覆写事实。
if [ -d reference_repos/RuoYi-master ]; then
  echo "pre-push: RuoYi 基线 ..."
  "$PY" benchmarks/benchmark_ruoyi.py --strict --offline > /dev/null
  echo "pre-push: RuoYi 基线通过 ✔"
fi

# 第 12 靶场（Module 24/25）：pygoat——Python Flask labs 全集 + 切片器
# 同名符号覆盖回归锁（50→119 单元）。
if [ -d reference_repos/pygoat-master ]; then
  echo "pre-push: pygoat 基线 ..."
  "$PY" benchmarks/benchmark_pygoat.py --strict --offline > /dev/null
  echo "pre-push: pygoat 基线通过 ✔"
fi

# 第 15 靶场（Module 29）：eladmin-mp——@el.check 注解语义 + MyBatis-Plus 判据
if [ -d reference_repos/eladmin-mp-master ]; then
  echo "pre-push: eladmin-mp 基线 ..."
  "$PY" benchmarks/benchmark_eladminmp.py --strict --offline > /dev/null
  echo "pre-push: eladmin-mp 基线通过 ✔"
fi
